<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 与 AxonLink 当前 Web 运行环境一致，独立解析此父 POM。 -->
        <version>3.1.1</version>
        <relativePath/>
    </parent>
    <groupId>com.axonlink</groupId>
    <artifactId>flowtran-local</artifactId>
    <version>0.1.0</version>
    <properties>
        <!-- 与生产扫描器使用的语言级别一致。 -->
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <!-- 单进程提供 JSON API 和随包发布的静态页面。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 与生产扫描器使用相同版本的 JavaParser AST。 -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
            <version>3.25.10</version>
        </dependency>
        <!-- 内嵌 SQLite，使用单个本地数据库文件。 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.54.1.0</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- 支持从本目录运行，也可以打包为独立可执行 JAR。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
